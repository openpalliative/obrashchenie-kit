{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://openpalliative.github.io/obrashchenie-kit/data/v1/pack.schema.json",
 "title": "Метаданные пакета T0",
 "description": "Версия, статус, ревьюеры и всё непроверенное",
 "type": "object",
 "properties": {
  "dataset": {
   "const": "pack"
  },
  "repo": {
   "const": "obrashchenie-kit"
  },
  "items": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "version",
     "status",
     "tiers_enabled",
     "reviewers",
     "reviewed_at",
     "released_at",
     "expires_after_days",
     "first_public_at",
     "notice",
     "documents",
     "receipt",
     "print_mark",
     "unverified",
     "neighbors",
     "verified",
     "verified_at",
     "source_ref",
     "rule_notes"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "x-message-ru": "id латиницей в нижнем регистре через дефис"
     },
     "version": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}(\\.\\d+)?$"
     },
     "status": {
      "enum": [
       "demo",
       "reviewed"
      ]
     },
     "tiers_enabled": {
      "type": "array",
      "items": {
       "enum": [
        "T0",
        "T1"
       ]
      }
     },
     "reviewers": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "alias",
        "role",
        "since"
       ],
       "additionalProperties": false,
       "properties": {
        "alias": {
         "type": "string",
         "minLength": 1
        },
        "role": {
         "type": "string",
         "minLength": 1
        },
        "since": {
         "type": "string",
         "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
         "x-message-ru": "дата в виде ГГГГ-ММ-ДД"
        }
       }
      }
     },
     "reviewed_at": {
      "type": [
       "string",
       "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "x-message-ru": "дата в виде ГГГГ-ММ-ДД или пусто"
     },
     "released_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "x-message-ru": "дата в виде ГГГГ-ММ-ДД"
     },
     "expires_after_days": {
      "type": "integer",
      "minimum": 1
     },
     "first_public_at": {
      "type": [
       "string",
       "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "x-message-ru": "дата в виде ГГГГ-ММ-ДД или пусто"
     },
     "notice": {
      "type": "string",
      "minLength": 1
     },
     "documents": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
       "x-message-ru": "id латиницей в нижнем регистре через дефис"
      }
     },
     "receipt": {
      "type": "object",
      "required": [
       "title",
       "lines"
      ],
      "additionalProperties": false,
      "properties": {
       "title": {
        "type": "string",
        "minLength": 1
       },
       "lines": {
        "type": "array",
        "items": {
         "type": "string",
         "minLength": 1
        }
       }
      }
     },
     "print_mark": {
      "type": "string",
      "minLength": 1
     },
     "unverified": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "dataset",
        "id",
        "label",
        "why"
       ],
       "additionalProperties": false,
       "properties": {
        "dataset": {
         "type": "string",
         "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
         "x-message-ru": "id латиницей в нижнем регистре через дефис"
        },
        "id": {
         "type": "string",
         "minLength": 1
        },
        "label": {
         "type": "string",
         "minLength": 1
        },
        "why": {
         "type": "string",
         "minLength": 1
        }
       }
      }
     },
     "neighbors": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "repo",
        "dataset",
        "version",
        "data_date",
        "fixture"
       ],
       "additionalProperties": false,
       "properties": {
        "repo": {
         "type": "string",
         "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
         "x-message-ru": "id латиницей в нижнем регистре через дефис"
        },
        "dataset": {
         "type": "string",
         "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
         "x-message-ru": "id латиницей в нижнем регистре через дефис"
        },
        "version": {
         "type": "string"
        },
        "data_date": {
         "type": "string",
         "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
         "x-message-ru": "дата в виде ГГГГ-ММ-ДД"
        },
        "fixture": {
         "type": "boolean",
         "x-message-ru": "значение true или false"
        }
       }
      }
     },
     "verified": {
      "type": "boolean",
      "x-message-ru": "значение true или false"
     },
     "verified_at": {
      "type": [
       "string",
       "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "x-message-ru": "дата в виде ГГГГ-ММ-ДД или пусто"
     },
     "source_ref": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "x-message-ru": "id латиницей в нижнем регистре через дефис"
     },
     "region_numbers": {
      "enum": [
       "verified_only",
       "all",
       "none"
      ],
      "description": "Какие номера из region-lines kit показывает: только verified:true и не синтетические"
     },
     "rule_notes": {
      "type": "array",
      "description": "Оговорки к сроку, когда правило применяется к адресату из списка to",
      "items": {
       "type": "object",
       "required": [
        "rule_id",
        "to",
        "text"
       ],
       "additionalProperties": false,
       "properties": {
        "rule_id": {
         "type": "string",
         "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "to": {
         "type": "array",
         "minItems": 1,
         "items": {
          "type": "string",
          "pattern": "^[a-z_]+$"
         }
        },
        "text": {
         "type": "string",
         "minLength": 1
        }
       }
      }
     }
    }
   }
  }
 }
}
